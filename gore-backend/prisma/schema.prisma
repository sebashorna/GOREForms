generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model acceso_dashboard {
  id                    Int                    @id @default(autoincrement())
  proyecto_id           Int?
  fecha_hora            DateTime?              @default(now()) @db.Timestamp(6)
  ip_usuario            String?                @db.VarChar(45)
  user_agent            String?
  seguimiento_proyectos seguimiento_proyectos? @relation(fields: [proyecto_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_proyecto")

  @@index([proyecto_id], map: "idx_acceso_dashboard_proyecto_id")
  @@index([proyecto_id], map: "idx_proyecto_id")
}

model seguimiento_proyectos {
  id                        Int                @id @default(autoincrement())
  codigo_cui                String             @db.VarChar(20)
  estado_general            String?            @db.VarChar(100)
  sisgedo                   String?            @db.VarChar(100)
  detalle_estado_general    String?
  estado_especifico         String?            @db.VarChar(100)
  detalle_estado_especifico String?
  timeline_inversion        String?
  acciones_programadas      String?
  fecha_registro            DateTime?          @default(now()) @db.Timestamp(6)
  acceso_dashboard          acceso_dashboard[]
}
